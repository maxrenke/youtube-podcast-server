{
  "manifest_version": 2,
  "name": "YouTube Podcast",
  "version": "1.0.0",
  "description": "Send the video, playlist or channel you are looking at to your self-hosted youtube-podcast-server.",
  "browser_specific_settings": {
    "gecko": {
      "id": "youtube-podcast@maxrenke.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["browsingActivity"]
      }
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "permissions": [
    "activeTab",
    "menus",
    "notifications",
    "storage",
    "https://podcast.maxrenke.com/*"
  ],
  "optional_permissions": ["*://*/*"],
  "background": {
    "scripts": ["common.js", "background.js"]
  },
  "browser_action": {
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    },
    "default_title": "Add to YouTube Podcast",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "browser_style": false
  }
}
